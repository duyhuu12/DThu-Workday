PORT=8080
FRONTEND_URL=http://localhost:3000

# Prisma CLI dùng DATABASE_URL khi migrate/generate.
DATABASE_URL="mysql://dthu_app:CHANGE_ME@127.0.0.1:3306/dthu_workday"

# Backend runtime dùng các biến bên dưới.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=dthu_app
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=dthu_workday
DATABASE_CONNECTION_LIMIT=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_ACQUIRE_TIMEOUT_MS=20000
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DATABASE_SSL=false

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=8h
DEFAULT_USER_PASSWORD=CHANGE_ME_DEFAULT_PASSWORD

# Chỉ bật khi chấp nhận xóa và tạo lại dữ liệu demo.
ALLOW_DATABASE_SEED=false
SEED_DEMO_PASSWORD=CHANGE_ME

