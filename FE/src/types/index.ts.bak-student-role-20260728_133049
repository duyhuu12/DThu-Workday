export type UserRole = 'student' | 'organizer' | 'admin' | 'superadmin';

export interface Role { id: string; name: string; key: UserRole; description: string; permissions: string[]; }
export interface User { id: string; email: string; name: string; role: UserRole; phone?: string; status: 'active' | 'locked'; createdAt: string; lastLogin?: string; }
export interface Faculty { id: string; name: string; code: string; }
export interface Class { id: string; name: string; code: string; facultyId: string; schoolYear: string; }
export interface Student {
  id: string; userId: string; studentCode: string; fullName: string; email: string; phone?: string;
  facultyId: string; classId: string; schoolYear: string; gender: 'male' | 'female'; birthDate?: string; hometown?: string;
  status: 'active' | 'locked'; requiredWorkdays: number; accumulatedWorkdays: number; completedWorkdays: number;
}
export type WorkShift = 'morning' | 'afternoon' | 'evening' | 'fullday';
export type EventStatus = 'draft' | 'pending' | 'approved' | 'open' | 'ongoing' | 'completed' | 'rejected' | 'cancelled';
export interface WorkEvent {
  id: string; code: string; name: string; description: string; workContent: string; location: string;
  date: string; startTime: string; endTime: string; shift: WorkShift;
  registrationOpen: string; registrationClose: string; cancellationDeadline: string;
  maxCapacity: number; registeredCount: number; workdayCredit: number;
  eligibleFacultyIds: string[]; eligibleClassIds: string[]; eligibleSchoolYears: string[];
  clothingRequirements: string; equipmentRequirements: string;
  contactPerson: string; contactPhone: string; organizerId: string; organizerName: string;
  status: EventStatus; createdAt: string; updatedAt: string;
}
export type RegistrationStatus = 'pending' | 'approved' | 'waitlist' | 'completed' | 'cancelled' | 'absent';
export interface Registration {
  id: string; eventId: string; studentId: string; studentCode: string; studentName: string;
  classId: string; className: string; facultyId: string; facultyName: string;
  status: RegistrationStatus; registeredAt: string; approvedAt?: string; approvedBy?: string;
  rejectionReason?: string; attendanceStatus?: AttendanceStatus; workdayResult?: number; notes?: string;
}
export type AttendanceStatus = 'not_checked' | 'checked_in' | 'checked_out' | 'late' | 'early_leave' | 'absent';
export interface Attendance { id: string; eventId: string; studentId: string; studentCode: string; studentName: string; className?: string; facultyName?: string; status: AttendanceStatus; checkInTime?: string; checkOutTime?: string; notes?: string; }
export type CreditStatus = 'pending' | 'recorded' | 'rejected' | 'adjusted';
export interface WorkCredit {
  id: string; studentId: string; studentCode: string; studentName: string; classId: string; className: string;
  facultyId: string; facultyName: string; eventId: string; eventName: string; eventDate: string;
  semester: string; schoolYear: string; creditValue: number; status: CreditStatus;
  notes?: string; adjustedBy?: string; adjustmentReason?: string; adjustedAt?: string; createdAt: string;
}
export type ComplaintType = 'credit' | 'attendance' | 'schedule' | 'organizer' | 'other';
export type ComplaintStatus = 'submitted' | 'processing' | 'resolved' | 'rejected';
export type ComplaintPriority = 'low' | 'medium' | 'high';
export interface ComplaintTimelineEntry { id: string; status: ComplaintStatus; note: string; actor: string; timestamp: string; }
export interface Complaint {
  id: string; code: string; studentId: string; studentCode: string; studentName: string;
  classId: string; className: string; facultyId: string; facultyName: string;
  eventId: string; eventName: string; type: ComplaintType; priority: ComplaintPriority;
  title: string; description: string; evidence: string[]; status: ComplaintStatus;
  response?: string; timeline: ComplaintTimelineEntry[]; createdAt: string; updatedAt: string;
}
export type NotificationType = 'registration' | 'event' | 'credit' | 'complaint' | 'system';
export interface Notification { id: string; userId: string; type: NotificationType; title: string; message: string; isRead: boolean; link?: string; createdAt: string; }
export interface ActivityLog { id: string; userId: string; userName: string; userRole: UserRole; action: string; affectedItem: string; oldValue?: string; newValue?: string; timestamp: string; ipAddress?: string; }
export interface SemesterConfig { id: string; name: string; schoolYear: string; startDate: string; endDate: string; requiredWorkdays: number; isActive: boolean; }
export interface SystemSettings { siteName: string; supportEmail: string; supportPhone: string; defaultRequiredWorkdays: number; maxConcurrentRegistrations: number; maintenanceMode: boolean; }
