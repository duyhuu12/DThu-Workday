'use client';

import { createContext, useCallback, useContext, useEffect, useMemo, useState } from 'react';
import type {
  ActivityLog, Attendance, Class, Complaint, Faculty, Notification, Registration,
  SemesterConfig, Student, SystemSettings, User, WorkCredit, WorkEvent,
} from '@/types';
import { API_BASE_URL, apiRequest } from '@/services/api';

const AUTH_KEY = 'dthu-auth';
const TOKEN_KEY = 'dthu-jwt-token';

const defaultSettings: SystemSettings = {
  siteName: 'DThU Workday',
  supportEmail: 'workday@dthu.edu.vn',
  supportPhone: '02776543210',
  defaultRequiredWorkdays: 12,
  maxConcurrentRegistrations: 3,
  maintenanceMode: false,
};

interface StoreState {
  students: Student[];
  events: WorkEvent[];
  registrations: Registration[];
  attendance: Attendance[];
  credits: WorkCredit[];
  complaints: Complaint[];
  notifications: Notification[];
  activityLogs: ActivityLog[];
  users: User[];
  faculties: Faculty[];
  classes: Class[];
  semesterConfigs: SemesterConfig[];
  settings: SystemSettings;
}

const initialState: StoreState = {
  students: [], events: [], registrations: [], attendance: [], credits: [], complaints: [],
  notifications: [], activityLogs: [], users: [], faculties: [], classes: [],
  semesterConfigs: [], settings: defaultSettings,
};

interface Ctx extends StoreState {
  currentUser: User | null;
  login: (email: string, password: string) => Promise<User>;
  logout: () => void;
  fetchEvents: () => Promise<void>;
  fetchRegistrations: () => Promise<void>;
  fetchCredits: () => Promise<void>;
  fetchComplaints: () => Promise<void>;
  fetchNotifications: () => Promise<void>;
  fetchFaculties: () => Promise<void>;
  fetchClasses: () => Promise<void>;
  fetchStudents: () => Promise<void>;
  fetchUsers: () => Promise<void>;
  fetchSettings: () => Promise<void>;
  fetchSemesters: () => Promise<void>;
  fetchActivityLogs: () => Promise<void>;
  addEvent: (e: Partial<WorkEvent>) => Promise<WorkEvent>;
  updateEvent: (id: string, p: Partial<WorkEvent>) => Promise<void>;
  addRegistration: (r: Partial<Registration>) => Promise<Registration>;
  updateRegistration: (id: string, p: Partial<Registration>) => Promise<void>;
  updateCredit: (id: string, p: Partial<WorkCredit>) => Promise<void>;
  addComplaint: (c: Partial<Complaint>) => Promise<Complaint>;
  updateComplaint: (id: string, p: Partial<Complaint>) => Promise<void>;
  markNotifRead: (id: string) => Promise<void>;
  markAllNotifsRead: () => Promise<void>;
  addNotification: (n: Partial<Notification>) => void;
  addFaculty: (f: Partial<Faculty>) => Promise<Faculty>;
  updateFaculty: (id: string, p: Partial<Faculty>) => Promise<void>;
  deleteFaculty: (id: string) => Promise<void>;
  addStudent: (s: Partial<Student>) => Promise<Student>;
  updateStudent: (id: string, p: Partial<Student>) => Promise<void>;
  deleteStudent: (id: string) => Promise<void>;
  addClass: (c: Partial<Class>) => Promise<Class>;
  updateClass: (id: string, p: Partial<Class>) => Promise<void>;
  deleteClass: (id: string) => Promise<void>;
  addUser: (u: Partial<User> & { password?: string }) => Promise<User>;
  updateUser: (id: string, p: Partial<User> & { password?: string }) => Promise<void>;
  deleteUser: (id: string) => Promise<void>;
  updateSettings: (p: Partial<SystemSettings>) => Promise<void>;
  addActivityLog: (l: Partial<ActivityLog>) => void;
}

function noopContext(): Ctx {
  const unavailable = async () => { throw new Error('AppStoreProvider is not ready'); };
  return {
    ...initialState,
    currentUser: null,
    login: unavailable as Ctx['login'], logout: () => {},
    fetchEvents: async () => {}, fetchRegistrations: async () => {}, fetchCredits: async () => {},
    fetchComplaints: async () => {}, fetchNotifications: async () => {}, fetchFaculties: async () => {},
    fetchClasses: async () => {}, fetchStudents: async () => {}, fetchUsers: async () => {},
    fetchSettings: async () => {}, fetchSemesters: async () => {}, fetchActivityLogs: async () => {},
    addEvent: unavailable as Ctx['addEvent'], updateEvent: async () => {},
    addRegistration: unavailable as Ctx['addRegistration'], updateRegistration: async () => {},
    updateCredit: async () => {}, addComplaint: unavailable as Ctx['addComplaint'], updateComplaint: async () => {},
    markNotifRead: async () => {}, markAllNotifsRead: async () => {}, addNotification: () => {},
    addFaculty: unavailable as Ctx['addFaculty'], updateFaculty: async () => {}, deleteFaculty: async () => {},
    addStudent: unavailable as Ctx['addStudent'], updateStudent: async () => {}, deleteStudent: async () => {},
    addClass: unavailable as Ctx['addClass'], updateClass: async () => {}, deleteClass: async () => {},
    addUser: unavailable as Ctx['addUser'], updateUser: async () => {}, deleteUser: async () => {},
    updateSettings: async () => {}, addActivityLog: () => {},
  };
}

const StoreCtx = createContext<Ctx>(noopContext());

function normalizeUser(user: User): User {
  return { ...user, role: user.role?.toLowerCase?.() as User['role'] };
}

export function AppStoreProvider({ children }: { children: React.ReactNode }) {
  const [state, setState] = useState<StoreState>(initialState);
  const [currentUser, setCurrentUser] = useState<User | null>(null);
  const [loaded, setLoaded] = useState(false);

  const replace = useCallback(<K extends keyof StoreState>(key: K, value: StoreState[K]) => {
    setState((prev) => ({ ...prev, [key]: value }));
  }, []);

  const fetchEvents = useCallback(async () => {
    const result = await apiRequest<WorkEvent[]>('/events');
    replace('events', result.data ?? []);
  }, [replace]);
  const fetchRegistrations = useCallback(async () => {
    const result = await apiRequest<Registration[]>('/registrations');
    replace('registrations', result.data ?? []);
  }, [replace]);
  const fetchCredits = useCallback(async () => {
    const result = await apiRequest<WorkCredit[]>('/credits');
    replace('credits', result.data ?? []);
  }, [replace]);
  const fetchComplaints = useCallback(async () => {
    const result = await apiRequest<Complaint[]>('/complaints');
    replace('complaints', result.data ?? []);
  }, [replace]);
  const fetchNotifications = useCallback(async () => {
    const result = await apiRequest<Notification[]>('/notifications');
    replace('notifications', result.data ?? []);
  }, [replace]);
  const fetchFaculties = useCallback(async () => {
    const result = await apiRequest<Faculty[]>('/system/faculties');
    replace('faculties', result.data ?? []);
  }, [replace]);
  const fetchClasses = useCallback(async () => {
    const result = await apiRequest<Class[]>('/system/classes');
    replace('classes', result.data ?? []);
  }, [replace]);
  const fetchStudents = useCallback(async () => {
    const result = await apiRequest<Student[]>('/system/students');
    replace('students', result.data ?? []);
  }, [replace]);
  const fetchUsers = useCallback(async () => {
    const result = await apiRequest<User[]>('/system/users');
    replace('users', result.data ?? []);
  }, [replace]);
  const fetchSettings = useCallback(async () => {
    const result = await apiRequest<SystemSettings>('/system/settings');
    if (result.data) replace('settings', result.data);
  }, [replace]);
  const fetchSemesters = useCallback(async () => {
    const result = await apiRequest<SemesterConfig[]>('/system/semesters');
    replace('semesterConfigs', result.data ?? []);
  }, [replace]);
  const fetchActivityLogs = useCallback(async () => {
    const result = await apiRequest<ActivityLog[]>('/system/activity-logs');
    replace('activityLogs', result.data ?? []);
  }, [replace]);

  const loadProtectedData = useCallback(async (user: User) => {
    const tasks: Promise<void>[] = [
      fetchEvents(), fetchRegistrations(), fetchCredits(), fetchComplaints(), fetchNotifications(), fetchStudents(),
    ];
    if (user.role === 'admin' || user.role === 'superadmin') tasks.push(fetchActivityLogs());
    if (user.role === 'superadmin') tasks.push(fetchUsers());
    await Promise.allSettled(tasks);
  }, [fetchEvents, fetchRegistrations, fetchCredits, fetchComplaints, fetchNotifications, fetchStudents, fetchActivityLogs, fetchUsers]);

  useEffect(() => {
    let cancelled = false;
    async function initialize() {
      localStorage.removeItem('dthu-store');
      await Promise.allSettled([fetchFaculties(), fetchClasses(), fetchSettings(), fetchSemesters()]);
      try {
        const rawUser = localStorage.getItem(AUTH_KEY);
        const token = localStorage.getItem(TOKEN_KEY);
        if (rawUser && token) {
          const user = normalizeUser(JSON.parse(rawUser) as User);
          if (!cancelled) setCurrentUser(user);
          await loadProtectedData(user);
        }
      } catch {
        localStorage.removeItem(AUTH_KEY);
        localStorage.removeItem(TOKEN_KEY);
      } finally {
        if (!cancelled) setLoaded(true);
      }
    }
    void initialize();
    return () => { cancelled = true; };
  }, [fetchFaculties, fetchClasses, fetchSettings, fetchSemesters, loadProtectedData]);

  const login = useCallback(async (email: string, password: string) => {
    const response = await fetch(`${API_BASE_URL}/auth/login`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password }),
    });
    const result = await response.json();
    if (!response.ok || !result.success) throw new Error(result.message || 'Email hoặc mật khẩu không đúng');
    const user = normalizeUser(result.data as User);
    localStorage.setItem(TOKEN_KEY, result.token);
    localStorage.setItem(AUTH_KEY, JSON.stringify(user));
    setCurrentUser(user);
    await loadProtectedData(user);
    return user;
  }, [loadProtectedData]);

  const logout = useCallback(() => {
    localStorage.removeItem(AUTH_KEY);
    localStorage.removeItem(TOKEN_KEY);
    setCurrentUser(null);
    setState((prev) => ({
      ...prev, students: [], events: [], registrations: [], attendance: [], credits: [], complaints: [],
      notifications: [], activityLogs: [], users: [],
    }));
  }, []);

  const addEvent = useCallback(async (input: Partial<WorkEvent>) => {
    const result = await apiRequest<WorkEvent>('/events', { method: 'POST', body: JSON.stringify(input) });
    if (!result.data) throw new Error('Máy chủ không trả về sự kiện vừa tạo');
    setState((prev) => ({ ...prev, events: [result.data!, ...prev.events] }));
    return result.data;
  }, []);
  const updateEvent = useCallback(async (id: string, input: Partial<WorkEvent>) => {
    const result = await apiRequest<WorkEvent>(`/events/${id}`, { method: 'PUT', body: JSON.stringify(input) });
    if (result.data) setState((prev) => ({ ...prev, events: prev.events.map((item) => item.id === id ? result.data! : item) }));
  }, []);

  const addRegistration = useCallback(async (input: Partial<Registration>) => {
    const result = await apiRequest<Registration>('/registrations', { method: 'POST', body: JSON.stringify({ eventId: input.eventId }) });
    if (!result.data) throw new Error('Máy chủ không trả về đăng ký vừa tạo');
    setState((prev) => ({ ...prev, registrations: [result.data!, ...prev.registrations] }));
    await fetchEvents();
    return result.data;
  }, [fetchEvents]);
  const updateRegistration = useCallback(async (id: string, input: Partial<Registration>) => {
    const studentCancels = currentUser?.role === 'student' && input.status === 'cancelled';
    const endpoint = studentCancels ? `/registrations/${id}/cancel` : `/registrations/${id}/status`;
    const result = await apiRequest<Registration>(endpoint, {
      method: studentCancels ? 'POST' : 'PUT',
      body: studentCancels ? undefined : JSON.stringify({ status: input.status, rejectionReason: input.rejectionReason }),
    });
    if (result.data) setState((prev) => ({ ...prev, registrations: prev.registrations.map((item) => item.id === id ? result.data! : item) }));
    await fetchEvents();
  }, [currentUser, fetchEvents]);

  const updateCredit = useCallback(async (id: string, input: Partial<WorkCredit>) => {
    const isStatusOnly = input.status !== undefined && input.creditValue === undefined;
    const endpoint = isStatusOnly ? `/credits/${id}/status` : `/credits/${id}/adjust`;
    const body = isStatusOnly
      ? { status: input.status }
      : { creditValue: input.creditValue, reason: input.adjustmentReason || input.notes || 'Điều chỉnh bởi quản trị viên' };
    const result = await apiRequest<WorkCredit>(endpoint, { method: 'PUT', body: JSON.stringify(body) });
    if (result.data) setState((prev) => ({ ...prev, credits: prev.credits.map((item) => item.id === id ? result.data! : item) }));
    await fetchStudents();
  }, [fetchStudents]);

  const addComplaint = useCallback(async (input: Partial<Complaint>) => {
    const result = await apiRequest<Complaint>('/complaints', {
      method: 'POST',
      body: JSON.stringify({
        title: input.title, type: input.type, priority: input.priority, eventId: input.eventId,
        content: input.description, evidence: input.evidence,
      }),
    });
    if (!result.data) throw new Error('Máy chủ không trả về khiếu nại vừa tạo');
    setState((prev) => ({ ...prev, complaints: [result.data!, ...prev.complaints] }));
    return result.data;
  }, []);
  const updateComplaint = useCallback(async (id: string, input: Partial<Complaint>) => {
    const result = await apiRequest<Complaint>(`/complaints/${id}/respond`, {
      method: 'PUT', body: JSON.stringify({ status: input.status, note: input.response }),
    });
    if (result.data) setState((prev) => ({ ...prev, complaints: prev.complaints.map((item) => item.id === id ? result.data! : item) }));
  }, []);

  const markNotifRead = useCallback(async (id: string) => {
    await apiRequest(`/notifications/${id}/read`, { method: 'PUT' });
    setState((prev) => ({ ...prev, notifications: prev.notifications.map((item) => item.id === id ? { ...item, isRead: true } : item) }));
  }, []);
  const markAllNotifsRead = useCallback(async () => {
    await apiRequest('/notifications/read-all', { method: 'PUT' });
    setState((prev) => ({ ...prev, notifications: prev.notifications.map((item) => ({ ...item, isRead: true })) }));
  }, []);
  const addNotification = useCallback((_input: Partial<Notification>) => {
    // Thông báo nghiệp vụ được backend tạo trong transaction. Chỉ tải lại để tránh dữ liệu giả ở localStorage.
    void fetchNotifications();
  }, [fetchNotifications]);

  const addFaculty = useCallback(async (input: Partial<Faculty>) => {
    const result = await apiRequest<Faculty>('/system/faculties', { method: 'POST', body: JSON.stringify(input) });
    if (!result.data) throw new Error('Máy chủ không trả về khoa vừa tạo');
    setState((prev) => ({ ...prev, faculties: [...prev.faculties, result.data!] }));
    return result.data;
  }, []);
  const updateFaculty = useCallback(async (id: string, input: Partial<Faculty>) => {
    const result = await apiRequest<Faculty>(`/system/faculties/${id}`, { method: 'PUT', body: JSON.stringify(input) });
    if (result.data) setState((prev) => ({ ...prev, faculties: prev.faculties.map((item) => item.id === id ? result.data! : item) }));
  }, []);
  const deleteFaculty = useCallback(async (id: string) => {
    await apiRequest(`/system/faculties/${id}`, { method: 'DELETE' });
    setState((prev) => ({ ...prev, faculties: prev.faculties.filter((item) => item.id !== id) }));
  }, []);

  const addStudent = useCallback(async (input: Partial<Student>) => {
    const result = await apiRequest<Student>('/system/students', { method: 'POST', body: JSON.stringify(input) });
    if (!result.data) throw new Error('Máy chủ không trả về sinh viên vừa tạo');
    setState((prev) => ({ ...prev, students: [result.data!, ...prev.students] }));
    return result.data;
  }, []);
  const updateStudent = useCallback(async (id: string, input: Partial<Student>) => {
    const result = await apiRequest<Student>(`/system/students/${id}`, { method: 'PUT', body: JSON.stringify(input) });
    if (result.data) setState((prev) => ({ ...prev, students: prev.students.map((item) => item.id === id ? result.data! : item) }));
  }, []);
  const deleteStudent = useCallback(async (id: string) => {
    await apiRequest(`/system/students/${id}`, { method: 'DELETE' });
    setState((prev) => ({ ...prev, students: prev.students.filter((item) => item.id !== id) }));
  }, []);

  const addClass = useCallback(async (input: Partial<Class>) => {
    const result = await apiRequest<Class>('/system/classes', { method: 'POST', body: JSON.stringify(input) });
    if (!result.data) throw new Error('Máy chủ không trả về lớp vừa tạo');
    setState((prev) => ({ ...prev, classes: [...prev.classes, result.data!] }));
    return result.data;
  }, []);
  const updateClass = useCallback(async (id: string, input: Partial<Class>) => {
    const result = await apiRequest<Class>(`/system/classes/${id}`, { method: 'PUT', body: JSON.stringify(input) });
    if (result.data) setState((prev) => ({ ...prev, classes: prev.classes.map((item) => item.id === id ? result.data! : item) }));
  }, []);
  const deleteClass = useCallback(async (id: string) => {
    await apiRequest(`/system/classes/${id}`, { method: 'DELETE' });
    setState((prev) => ({ ...prev, classes: prev.classes.filter((item) => item.id !== id) }));
  }, []);

  const addUser = useCallback(async (input: Partial<User> & { password?: string }) => {
    const result = await apiRequest<User>('/system/users', { method: 'POST', body: JSON.stringify(input) });
    if (!result.data) throw new Error('Máy chủ không trả về người dùng vừa tạo');
    setState((prev) => ({ ...prev, users: [result.data!, ...prev.users] }));
    return result.data;
  }, []);
  const updateUser = useCallback(async (id: string, input: Partial<User> & { password?: string }) => {
    const result = await apiRequest<User>(`/system/users/${id}`, { method: 'PUT', body: JSON.stringify(input) });
    if (result.data) setState((prev) => ({ ...prev, users: prev.users.map((item) => item.id === id ? result.data! : item) }));
  }, []);
  const deleteUser = useCallback(async (id: string) => {
    await apiRequest(`/system/users/${id}`, { method: 'DELETE' });
    setState((prev) => ({ ...prev, users: prev.users.filter((item) => item.id !== id) }));
  }, []);

  const updateSettings = useCallback(async (input: Partial<SystemSettings>) => {
    const result = await apiRequest<SystemSettings>('/system/settings', { method: 'PUT', body: JSON.stringify(input) });
    if (result.data) replace('settings', result.data);
  }, [replace]);

  const addActivityLog = useCallback((input: Partial<ActivityLog>) => {
    void apiRequest('/system/activity-logs', { method: 'POST', body: JSON.stringify(input) })
      .then(() => fetchActivityLogs())
      .catch((error) => console.error('Không thể ghi nhật ký hoạt động:', error));
  }, [fetchActivityLogs]);

  const value = useMemo<Ctx>(() => ({
    ...state, currentUser, login, logout,
    fetchEvents, fetchRegistrations, fetchCredits, fetchComplaints, fetchNotifications,
    fetchFaculties, fetchClasses, fetchStudents, fetchUsers, fetchSettings, fetchSemesters, fetchActivityLogs,
    addEvent, updateEvent, addRegistration, updateRegistration, updateCredit, addComplaint, updateComplaint,
    markNotifRead, markAllNotifsRead, addNotification,
    addFaculty, updateFaculty, deleteFaculty,
    addStudent, updateStudent, deleteStudent,
    addClass, updateClass, deleteClass,
    addUser, updateUser, deleteUser,
    updateSettings, addActivityLog,
  }), [
    state, currentUser, login, logout, fetchEvents, fetchRegistrations, fetchCredits, fetchComplaints,
    fetchNotifications, fetchFaculties, fetchClasses, fetchStudents, fetchUsers, fetchSettings,
    fetchSemesters, fetchActivityLogs, addEvent, updateEvent, addRegistration, updateRegistration,
    updateCredit, addComplaint, updateComplaint, markNotifRead, markAllNotifsRead, addNotification,
    addFaculty, updateFaculty, deleteFaculty, addStudent, updateStudent, deleteStudent,
    addClass, updateClass, deleteClass, addUser, updateUser, deleteUser, updateSettings, addActivityLog,
  ]);

  if (!loaded) {
    return <div className="flex min-h-screen items-center justify-center bg-background"><div className="h-10 w-10 animate-spin rounded-full border-4 border-primary/30 border-t-primary" /></div>;
  }
  return <StoreCtx.Provider value={value}>{children}</StoreCtx.Provider>;
}

export function useAppStore() { return useContext(StoreCtx); }
export function useCurrentStudent() {
  const { currentUser, students } = useAppStore();
  return students.find((student) => student.userId === currentUser?.id) ?? null;
}
